# App Store Server Notifications Webhook

# Notification provider(s), comma-separated: telegram (default), ntfy, email
# e.g. telegram,email  — aliases: both = telegram,ntfy; all = telegram,ntfy,email
NOTIFICATION_PROVIDER=telegram,ntfy,email

# Optional ntfy provider (required when NOTIFICATION_PROVIDER=ntfy or both)
NTFY_URL=
NTFY_TOKEN=

# Optional email provider via Resend (required when NOTIFICATION_PROVIDER includes email)
# API key: https://resend.com/api-keys
RESEND_API_KEY=
# Optional sender. Leave empty to use onboarding@resend.dev, which only delivers to
# your own Resend account email. To send elsewhere, use a domain verified in Resend,
# e.g. "App Store <notify@yourdomain.com>"
EMAIL_FROM=
# Recipient(s), comma-separated
EMAIL_TO=

# Telegram Bot (shared across all apps)
# Create a bot via @BotFather and get the token
TELEGRAM_BOT_TOKEN=
# Chat ID (use @userinfobot to find your chat ID, or a channel ID like -1001234567890)
TELEGRAM_CHAT_ID=

# Optional: set to true to enable Apple's online OCSP certificate revocation checks.
# Leave false/empty for local ngrok testing if ocsp.apple.com is flaky or blocked.
APPLE_ENABLE_ONLINE_CHECKS=

# Apps — format: APP_<SLUG>=<bundleId>:<appAppleId>
# The slug becomes the URL path: /api/apple/<slug>
APP_MYAPP=com.yourcompany.myapp:1234567890
